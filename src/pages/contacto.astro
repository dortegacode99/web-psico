---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, telLink, mailtoLink, whatsappUrl, mapaUrl } from '../data/site';
import { contacto } from '../data/content';
import { Icon } from 'astro-icon/components';

const { cabecera } = contacto;
---

<BaseLayout
  title="Contacto"
  description={`Contacta con ${site.tituloProfesional} en ${site.ciudad}: teléfono, email, WhatsApp o formulario.`}
>
  <section class="section">
    <div class="container-prose max-w-3xl text-center">
      {cabecera.etiqueta && <span class="eyebrow">{cabecera.etiqueta}</span>}
      <h1 class="mt-3 text-4xl sm:text-5xl text-brand-900">{cabecera.titulo}</h1>
      {cabecera.parrafos.map((p) => <p class="mt-6 text-lg text-brand-700">{p}</p>)}
    </div>
  </section>

  <section class="pb-20">
    <div class="container-prose grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-3 bg-white rounded-3xl p-8 sm:p-10 border border-brand-100 shadow-soft">
        <h2 class="font-display text-2xl text-brand-900 mb-6">{contacto.formularioTitulo}</h2>
        <ContactForm />
      </div>

      <aside class="lg:col-span-2 space-y-6">
        <div class="bg-cream-100 rounded-3xl p-7">
          <h3 class="font-display font-semibold text-brand-900 text-lg">Otras vías</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a href={telLink} class="flex items-center gap-3 text-brand-800 hover:text-brand-600">
                <Icon name="lucide:phone" class="w-5 h-5 text-brand-500" /> {site.telefono}
              </a>
            </li>
            <li>
              <a href={mailtoLink} class="flex items-center gap-3 text-brand-800 hover:text-brand-600">
                <Icon name="lucide:mail" class="w-5 h-5 text-brand-500" /> {site.email}
              </a>
            </li>
            <li>
              <a href={whatsappUrl} target="_blank" rel="noopener" class="flex items-center gap-3 text-brand-800 hover:text-brand-600">
                <Icon name="lucide:message-circle" class="w-5 h-5 text-brand-500" /> WhatsApp
              </a>
            </li>
            {site.redes.linkedin && (
              <li>
                <a href={site.redes.linkedin} target="_blank" rel="noopener" class="flex items-center gap-3 text-brand-800 hover:text-brand-600">
                  <Icon name="lucide:linkedin" class="w-5 h-5 text-brand-500" /> LinkedIn
                </a>
              </li>
            )}
          </ul>
        </div>

        <div class="bg-cream-100 rounded-3xl p-7">
          <h3 class="font-display font-semibold text-brand-900 text-lg">Disponibilidad</h3>
          {contacto.horario.length > 0 && (
            <p class="mt-3 text-sm text-brand-700 flex gap-3">
              <Icon name="lucide:clock" class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" />
              <span>
                {contacto.horario.map((linea, i) => <Fragment>{i > 0 && <br />}{linea}</Fragment>)}
              </span>
            </p>
          )}
          {(contacto.modalidad || site.direccion) && (
            <p class="mt-3 text-sm text-brand-700 flex gap-3">
              <Icon name="lucide:map-pin" class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" />
              <span>
                {contacto.modalidad}
                {contacto.modalidad && site.direccion && <br />}
                {site.direccion && (
                  <a href={mapaUrl} target="_blank" rel="noopener" class="underline text-brand-800 hover:text-brand-900">{site.direccion}</a>
                )}
              </span>
            </p>
          )}
        </div>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener"
          class="block bg-[#25D366]/10 hover:bg-[#25D366]/20 border border-[#25D366]/30 rounded-3xl p-6 transition-colors"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#25D366] flex items-center justify-center shrink-0">
              <Icon name="lucide:message-circle" class="w-5 h-5 text-white" />
            </div>
            <p class="font-display font-semibold text-brand-900">{contacto.whatsapp.titulo}</p>
          </div>
          {contacto.whatsapp.texto && (
            <p class="text-sm text-brand-700 mt-3">{contacto.whatsapp.texto}</p>
          )}
        </a>

      </aside>
    </div>
  </section>
</BaseLayout>
