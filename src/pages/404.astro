---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="section">
    <div class="container-prose max-w-xl text-center py-20">
      <p class="text-7xl font-display font-bold text-brand-300">404</p>
      <h1 class="mt-4 text-3xl text-brand-900">Esta página se ha perdido</h1>
      <p class="mt-4 text-brand-700">
        Puede que el enlace esté roto o que la página haya cambiado de dirección.
      </p>
      <a href="/" class="btn-primary mt-8">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
