---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { sobreMi, negritas } from '../data/content';

const { cabecera, valoresTitulo, valores, formacion, enfoque } = sobreMi;
---

<BaseLayout
  title="Sobre mí"
  description={sobreMi.descripcionGoogle || undefined}
>
  <section class="section">
    <div class="container-prose max-w-3xl text-center">
      {cabecera.etiqueta && <span class="eyebrow">{cabecera.etiqueta}</span>}
      <h1 class="mt-3 text-4xl sm:text-5xl text-brand-900">
        {cabecera.titulo}
      </h1>
      {cabecera.parrafos.map((p) => <p class="mt-6 text-lg text-brand-700">{p}</p>)}
    </div>
  </section>

  <AboutSection pegada />

  <section class="section bg-white">
    {valoresTitulo && (
      <div class="container-prose">
        <h2 class="text-3xl text-brand-900 mb-8 lg:mb-10">{valoresTitulo}</h2>
      </div>
    )}
    <div class="container-prose grid lg:grid-cols-3 gap-4 lg:gap-8">
      {valores.map((v) => (
        <div class="bg-cream-100 rounded-3xl p-6 lg:p-7">
          <div class="w-10 h-10 lg:w-12 lg:h-12 rounded-2xl bg-brand-500 text-white flex items-center justify-center">
            <Icon name={v.icono} class="w-5 h-5 lg:w-6 lg:h-6" />
          </div>
          <h3 class="mt-4 lg:mt-5 font-display font-semibold text-lg text-brand-900">{v.titulo}</h3>
          <p class="mt-2 text-sm text-brand-700 leading-relaxed">{v.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container-prose grid lg:grid-cols-3 gap-12">
      <div>
        {formacion.etiqueta && <span class="eyebrow">{formacion.etiqueta}</span>}
        <h2 class="mt-3 text-3xl text-brand-900">{formacion.titulo}</h2>
        <ul class="mt-6 space-y-3">
          {formacion.lista.map((f) => (
            <li class="flex gap-3 text-brand-700">
              <Icon name="lucide:graduation-cap" class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        {enfoque.etiqueta && <span class="eyebrow">{enfoque.etiqueta}</span>}
        <h2 class="mt-3 text-3xl text-brand-900">{enfoque.titulo}</h2>
        <div class="mt-6 space-y-4 text-brand-700 leading-relaxed text-justify">
          {enfoque.parrafos.map((p) => <p set:html={negritas(p)} />)}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner pegada />
</BaseLayout>
