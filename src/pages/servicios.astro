---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { paginaServicios } from '../data/content';

const { cabecera, sesiones } = paginaServicios;
---

<BaseLayout
  title="Servicios"
  description={paginaServicios.descripcionGoogle || undefined}
>
  <section class="section">
    <div class="container-prose max-w-3xl text-center">
      {cabecera.etiqueta && <span class="eyebrow">{cabecera.etiqueta}</span>}
      <h1 class="mt-3 text-4xl sm:text-5xl text-brand-900">{cabecera.titulo}</h1>
      {cabecera.parrafos.map((p) => <p class="mt-6 text-lg text-brand-700">{p}</p>)}
    </div>
  </section>

  <ServicesGrid />

  <section class="section">
    <div class="container-prose">
      <div>
        {sesiones.etiqueta && <span class="eyebrow">{sesiones.etiqueta}</span>}
        <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">{sesiones.titulo}</h2>
      </div>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {sesiones.lista.map((m) => (
          <div class="bg-white rounded-3xl p-7 border border-brand-100">
            <div class="w-12 h-12 rounded-2xl bg-accent-100 flex items-center justify-center">
              <Icon name={m.icono} class="w-6 h-6 text-accent-600" />
            </div>
            <h3 class="mt-5 font-display font-semibold text-lg text-brand-900">{m.titulo}</h3>
            <p class="mt-2 text-sm text-brand-700 leading-relaxed">{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSteps />

  <CtaBanner />
</BaseLayout>
