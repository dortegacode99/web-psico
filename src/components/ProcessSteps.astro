---
import { proceso } from '../data/content';

interface Props {
  /** Sin margen de arriba: la sección anterior tiene el mismo fondo (si no, se suman los dos). */
  pegada?: boolean;
}
const { pegada = false } = Astro.props;
---

<section class:list={['section', pegada && '!pt-0']}>
  <div class="container-prose">
    <div>
      {proceso.etiqueta && <span class="eyebrow">{proceso.etiqueta}</span>}
      <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">
        {proceso.titulo}
      </h2>
      {proceso.parrafos.map((p) => <p class="mt-4 text-brand-700 lg:text-lg">{p}</p>)}
    </div>

    <ol class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {proceso.pasos.map((paso) => (
        <li class="relative bg-cream-100 rounded-3xl p-7 border border-brand-100">
          <span class="absolute -top-4 left-7 px-3 py-1 rounded-full bg-brand-500 text-white text-xs font-semibold tracking-wider">
            {paso.numero}
          </span>
          <h3 class="mt-3 font-display font-semibold text-brand-900">{paso.titulo}</h3>
          <p class="mt-2 text-sm text-brand-700 leading-relaxed">{paso.descripcion}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
