---
import { Icon } from 'astro-icon/components';
import { presentacion } from '../data/content';

interface Props {
  /** Si true, renderiza versión resumida con CTA a /sobre-mi (para home). */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const parrafos = compact
  ? presentacion.parrafos
  : [...presentacion.parrafos, ...presentacion.ampliacion];
---

<section class="section">
  <div class="container-prose grid lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-5 order-2 lg:order-1">
      <div class="aspect-[3/4] rounded-3xl shadow-soft overflow-hidden">
        <img
          src="/images/sobre-mi.png"
          alt="Acuarela de un sendero serpenteante en un paisaje natural al amanecer, como metáfora del proceso terapéutico"
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="lg:col-span-7 order-1 lg:order-2">
      {presentacion.etiqueta && <span class="eyebrow">{presentacion.etiqueta}</span>}
      <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">
        {presentacion.titulo}
      </h2>
      <div class="mt-6 space-y-4 text-brand-700 leading-relaxed">
        {parrafos.map((p) => <p>{p}</p>)}
      </div>

      {compact && (
        <a href="/sobre-mi" class="btn-secondary mt-8">
          {presentacion.botonPortada}
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
      )}
    </div>
  </div>
</section>
