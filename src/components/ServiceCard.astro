---
import { Icon } from 'astro-icon/components';

interface Props {
  icono: string;
  titulo: string;
  descripcion: string;
  /** Color del icono: verde salvia (adultos) o amarillo cálido (infanto-juvenil). */
  tono?: 'brand' | 'accent';
  /** Posición en la rejilla: escalona la entrada de las tarjetas al cambiar de pestaña. */
  orden?: number;
}
const { icono, titulo, descripcion, tono = 'brand', orden = 0 } = Astro.props;

// Clases completas (no montadas a trozos) para que Tailwind las encuentre al compilar.
const tonos = {
  brand: {
    caja: 'bg-brand-100 group-hover:bg-brand-500',
    icono: 'text-brand-600 group-hover:text-white',
    pista: 'bg-brand-50 text-brand-500',
  },
  accent: {
    caja: 'bg-accent-100 group-hover:bg-accent-400',
    icono: 'text-accent-700 group-hover:text-brand-900',
    pista: 'bg-accent-50 text-accent-700',
  },
}[tono];
---

<!--
  Sin JavaScript la tarjeta se ve entera (icono, nombre y descripción). Con él, el script de
  abajo la convierte en una tarjeta que se da la vuelta al pulsarla: delante el icono y el
  nombre, detrás la descripción. Los estilos están en global.css (.tarjeta-volteo).
-->
<article class="tarjeta-volteo group" data-tono={tono} style={`--i: ${orden}`}>
  <div class="tarjeta-interior">
    <div class="tarjeta-cara tarjeta-cara-delante">
      <div class:list={['shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-2xl transition-colors flex items-center justify-center', tonos.caja]}>
        <Icon name={icono} class:list={['w-5 h-5 sm:w-6 sm:h-6 transition-colors', tonos.icono]} />
      </div>
      <h3 class="mt-4 sm:mt-5 text-base sm:text-lg font-display font-semibold text-brand-900 leading-snug">{titulo}</h3>
      <span aria-hidden="true" class:list={['tarjeta-pista', tonos.pista]}>
        <Icon name="lucide:plus" class="w-4 h-4" />
      </span>
    </div>
    <div class="tarjeta-cara tarjeta-cara-detras">
      <p class="tarjeta-titulo-detras font-display font-semibold text-sm text-brand-900 pr-8">{titulo}</p>
      <p class="text-sm text-brand-700 leading-relaxed">{descripcion}</p>
      <span aria-hidden="true" class:list={['tarjeta-pista', tonos.pista]}>
        <Icon name="lucide:x" class="w-4 h-4" />
      </span>
    </div>
  </div>
</article>

<script>
  const raices = [...document.querySelectorAll<HTMLElement>('[data-servicios]')];
  raices.forEach((raiz) => raiz.classList.add('volteo-on'));

  const abierta = (i: HTMLElement) => i.getAttribute('aria-expanded') === 'true';
  // Alto natural de la cara de atrás (la descripción), no el de la tarjeta.
  const altoDetras = (i: HTMLElement) => {
    const detras = i.querySelector<HTMLElement>('.tarjeta-cara-detras')!;
    detras.style.bottom = 'auto';
    const alto = detras.offsetHeight;
    detras.style.bottom = '';
    return alto;
  };

  /**
   * Todas las tarjetas de una pestaña miden siempre lo mismo. Cerradas, lo que pide el nombre
   * más largo; si hay alguna abierta, crecen todas a la vez hasta lo que pida su descripción.
   * En móvil (una por fila) no hay tarjetas al lado, así que solo crece la que se abre: si
   * crecieran todas, la página daría un salto enorme.
   * Con `medir` se recalcula el alto cerradas (al cargar, al cambiar el ancho o de pestaña).
   */
  const ajustar = (rejilla: HTMLElement, medir = false) => {
    if (rejilla.offsetParent === null) return; // pestaña oculta: se ajusta al enseñarla
    const interiores = [...rejilla.querySelectorAll<HTMLElement>('.tarjeta-interior')];
    if (medir || !rejilla.dataset.altoCerradas) {
      rejilla.classList.add('sin-transicion');
      interiores.forEach((i) => (i.style.height = ''));
      rejilla.dataset.altoCerradas = String(
        Math.max(...interiores.map((i) => i.querySelector<HTMLElement>('.tarjeta-cara-delante')!.offsetHeight)),
      );
    }
    const cerradas = Number(rejilla.dataset.altoCerradas);
    if (getComputedStyle(rejilla).gridTemplateColumns.split(' ').length === 1) {
      interiores.forEach((i) => (i.style.height = `${abierta(i) ? Math.max(cerradas, altoDetras(i)) : cerradas}px`));
    } else {
      const alto = Math.max(cerradas, ...interiores.filter(abierta).map(altoDetras));
      interiores.forEach((i) => (i.style.height = `${alto}px`));
    }
    if (medir) {
      void rejilla.offsetHeight;
      rejilla.classList.remove('sin-transicion');
    }
  };
  const ajustarTodas = () =>
    document.querySelectorAll<HTMLElement>('.volteo-on .servicios-tarjetas').forEach((r) => ajustar(r, true));

  document.querySelectorAll<HTMLElement>('.tarjeta-volteo').forEach((tarjeta) => {
    const interior = tarjeta.querySelector<HTMLElement>('.tarjeta-interior')!;
    const delante = tarjeta.querySelector<HTMLElement>('.tarjeta-cara-delante')!;
    const detras = tarjeta.querySelector<HTMLElement>('.tarjeta-cara-detras')!;
    const rejilla = tarjeta.closest<HTMLElement>('.servicios-tarjetas')!;
    const titulo = tarjeta.querySelector('h3')?.textContent?.trim() ?? '';

    interior.setAttribute('role', 'button');
    interior.tabIndex = 0;
    interior.setAttribute('aria-expanded', 'false');
    interior.setAttribute('aria-label', `${titulo}: ver descripción`);
    detras.setAttribute('aria-hidden', 'true');

    const voltear = () => {
      const abrir = !abierta(interior);
      interior.setAttribute('aria-expanded', String(abrir));
      interior.setAttribute('aria-label', abrir ? titulo : `${titulo}: ver descripción`);
      detras.setAttribute('aria-hidden', String(!abrir));
      delante.setAttribute('aria-hidden', String(abrir));
      ajustar(rejilla);
    };

    interior.addEventListener('click', voltear);
    interior.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        voltear();
      }
    });
  });

  ajustarTodas();
  // Al cambiar de pestaña (el panel deja de estar oculto), al cambiar el ancho y cuando
  // terminan de cargar las fuentes (cambian el alto del texto).
  raices.forEach((raiz) =>
    new MutationObserver(ajustarTodas).observe(raiz, { subtree: true, attributeFilter: ['hidden'] }),
  );
  let anchoPrevio = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === anchoPrevio) return;
    anchoPrevio = window.innerWidth;
    ajustarTodas();
  });
  document.fonts?.ready.then(ajustarTodas);
</script>
