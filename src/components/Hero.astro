---
import { site } from '../data/site';
import { portada } from '../data/content';
import { Icon } from 'astro-icon/components';
---

<section class="relative overflow-hidden">
  <img
    src="/images/og-image.jpg"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 w-full h-full object-cover object-center opacity-60"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream-50/40 via-transparent to-white"></div>

  <div class="container-prose grid lg:grid-cols-2 gap-12 items-center py-20 lg:py-28">
    <div>
      <span class="eyebrow">{site.tituloProfesional} · {site.ciudad}</span>
      <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl text-brand-900 leading-tight">
        {site.tagline}
      </h1>
      {portada.parrafos.map((p) => (
        <p class="mt-6 text-lg text-brand-700 max-w-xl">{p}</p>
      ))}

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contacto" class="btn-primary">
          <Icon name="lucide:mail" class="w-4 h-4" />
          {portada.boton}
        </a>
      </div>

      {portada.destacados.length > 0 && (
        <div class="mt-10 grid grid-cols-3 gap-6 max-w-md">
          {portada.destacados.map((d) => (
            <div>
              <p class="text-2xl font-display font-bold text-brand-700">{d.valor}</p>
              <p class="text-xs text-brand-600">{d.texto}</p>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="relative">
      <div class="aspect-[4/5] rounded-3xl bg-brand-100 shadow-soft overflow-hidden flex items-center justify-center">
        <!-- EDITAR: sustituir por <Image src="..." alt="Retrato profesional" /> cuando haya foto -->
        <div class="text-center p-8 text-brand-600">
          <Icon name="lucide:image" class="w-16 h-16 mx-auto opacity-40" />
          <p class="mt-3 text-sm">Foto profesional cálida<br/>(sustituir en /public/images)</p>
        </div>
      </div>
    </div>
  </div>
</section>
