---
import { site } from '../data/site';
import { portada } from '../data/content';
import { Icon } from 'astro-icon/components';
---

<section class="relative overflow-hidden">
  <img
    src="/images/hero-fondo.webp"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 w-full h-full object-cover object-center opacity-60"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-cream-50/40 via-transparent to-cream-50"></div>

  <div class="container-prose grid lg:grid-cols-2 gap-12 items-center pt-20 pb-8 lg:pt-20 lg:pb-14 xl:pt-28 xl:pb-16">
    <div>
      <span class="eyebrow">{site.tituloProfesional} · {site.ciudad}</span>
      <h1 class="mt-4 text-3xl sm:text-4xl lg:text-[2.6rem] xl:text-5xl text-brand-900 leading-tight text-balance">
        {site.tagline}
      </h1>
      {portada.parrafos.map((p) => (
        <p class="mt-6 text-lg text-brand-700 max-w-xl">{p}</p>
      ))}

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contacto" class="btn-primary">
          <Icon name="lucide:mail" class="w-4 h-4" />
          {portada.boton}
        </a>
      </div>

      {portada.destacados.length > 0 && (
        <div class:list={['mt-10 grid gap-6', portada.destacados.length === 3 ? 'grid-cols-3 max-w-md' : portada.destacados.length === 2 ? 'grid-cols-2 max-w-xs' : 'max-w-[10rem]']}>
          {portada.destacados.map((d) => (
            <div>
              <p class="text-2xl font-display font-bold text-brand-700">{d.valor}</p>
              <p class="text-xs text-brand-600">{d.texto}</p>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="relative">
      <div class="aspect-[4/5] rounded-3xl bg-brand-100 shadow-soft overflow-hidden">
        <img
          src="/images/jacobo-chamorro.jpg"
          alt={`Retrato de ${site.nombre}`}
          width="1066"
          height="1600"
          class="w-full h-full object-cover"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
