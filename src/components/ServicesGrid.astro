---
import { servicios } from '../data/content';
import ServiceCard from './ServiceCard.astro';
---

<section class="section bg-white">
  <div class="container-prose">
    <div class="max-w-2xl">
      {servicios.etiqueta && <span class="eyebrow">{servicios.etiqueta}</span>}
      <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">
        {servicios.titulo}
      </h2>
      {servicios.parrafos.map((p) => <p class="mt-4 text-brand-700">{p}</p>)}
    </div>

    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicios.lista.map((s) => <ServiceCard {...s} />)}
    </div>
  </div>
</section>
