---
import { servicios } from '../data/content';
import ServiceCard from './ServiceCard.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  /** Fondo blanco (por defecto); sin él, la sección toma el crema de la página. */
  fondoBlanco?: boolean;
}
const { fondoBlanco = true } = Astro.props;

const { grupos } = servicios;
// Con una sola pestaña (la otra se ha quedado sin tarjetas) no hace falta selector.
const conPestanas = grupos.length > 1;
const tono = (id: string) => (id === 'infanto-juvenil' ? 'accent' : 'brand');
---

<section class:list={['section', fondoBlanco && 'bg-white']}>
  <div class="container-prose" data-servicios>
    <div class="max-w-2xl">
      {servicios.etiqueta && <span class="eyebrow">{servicios.etiqueta}</span>}
      <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">
        {servicios.titulo}
      </h2>
      {servicios.parrafos.map((p) => <p class="mt-4 text-brand-700">{p}</p>)}
    </div>

    {conPestanas && (
      <div
        role="tablist"
        aria-label="Servicios por edad"
        data-activo={grupos[0].id}
        class="servicios-pestanas group relative mt-10 grid grid-cols-2 w-full sm:w-auto sm:inline-grid p-1 rounded-full bg-cream-100 border border-brand-100"
      >
        <span
          aria-hidden="true"
          class="absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] rounded-full bg-white shadow-soft ring-1 ring-brand-200 transition-all duration-500 ease-[cubic-bezier(.3,1.25,.5,1)] group-data-[activo=infanto-juvenil]:translate-x-full group-data-[activo=infanto-juvenil]:bg-accent-50 group-data-[activo=infanto-juvenil]:ring-accent-300"
        ></span>
        {grupos.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={g.id}
            data-grupo={g.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`servicios-panel-${g.id}`}
            tabindex={i === 0 ? 0 : -1}
            class="relative z-10 rounded-full px-4 sm:px-8 py-2.5 text-center text-brand-600 hover:text-brand-800 aria-selected:text-brand-900 transition-colors"
          >
            <span class="block font-display font-semibold">{g.pestana}</span>
            {g.detalle && <span class="block text-xs opacity-80">{g.detalle}</span>}
          </button>
        ))}
      </div>
    )}

    {grupos.map((g, i) => (
      <div
        id={`servicios-panel-${g.id}`}
        role={conPestanas ? 'tabpanel' : undefined}
        aria-labelledby={conPestanas ? g.id : undefined}
        hidden={i > 0}
      >
        {/* Sin JavaScript se ven las dos listas seguidas, cada una con su título. */}
        {conPestanas && <h3 class="servicios-titulo-sin-js hidden mt-12 font-display text-xl text-brand-900">{g.pestana}</h3>}
        <div class:list={['servicios-tarjetas grid sm:grid-cols-2 lg:grid-cols-3 gap-6', conPestanas ? 'mt-8' : 'mt-12']}>
          {g.lista.map((s, orden) => <ServiceCard {...s} tono={tono(g.id)} orden={orden} />)}
        </div>
      </div>
    ))}
  </div>

  <!-- La descripción de la tarjeta pulsada (la rellena el script de abajo). -->
  <dialog class="servicio-dialogo" aria-labelledby="servicio-dialogo-titulo">
    <div class="servicio-dialogo-panel">
      <button
        type="button"
        data-cerrar
        aria-label="Cerrar"
        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/70 hover:bg-white text-brand-600 flex items-center justify-center transition-colors"
      >
        <Icon name="lucide:x" class="w-5 h-5" />
      </button>
      <div data-icono></div>
      <h3 id="servicio-dialogo-titulo" class="mt-5 pr-10 font-display font-semibold text-xl sm:text-2xl text-brand-900"></h3>
      <p data-descripcion class="mt-3 text-brand-700 leading-relaxed"></p>
      <a href="/contacto" class="btn-primary mt-7">
        <Icon name="lucide:mail" class="w-4 h-4" />
        Contacta conmigo
      </a>
    </div>
  </dialog>
</section>

<noscript>
  <style>
    [data-servicios] [role='tabpanel'][hidden] { display: block !important; }
    [data-servicios] [role='tablist'] { display: none !important; }
    [data-servicios] .servicios-titulo-sin-js { display: block !important; }
  </style>
</noscript>

<script>
  // Tarjetas: solo icono y nombre; al pulsar, la descripción se abre en la ventana.
  document.querySelectorAll<HTMLElement>('[data-servicios]').forEach((raiz) => {
    const seccion = raiz.closest('section')!;
    const dialogo = seccion.querySelector<HTMLDialogElement>('.servicio-dialogo');
    if (!dialogo || typeof dialogo.showModal !== 'function') return; // navegador muy viejo: tarjetas enteras
    raiz.classList.add('tarjetas-js');

    const panel = dialogo.querySelector<HTMLElement>('.servicio-dialogo-panel')!;
    const hueco = dialogo.querySelector<HTMLElement>('[data-icono]')!;
    const titulo = dialogo.querySelector<HTMLElement>('h3')!;
    const descripcion = dialogo.querySelector<HTMLElement>('[data-descripcion]')!;
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    let origen: HTMLElement | null = null;

    const abrir = (tarjeta: HTMLElement) => {
      origen = tarjeta;
      panel.dataset.tono = tarjeta.dataset.tono;
      hueco.replaceChildren(tarjeta.querySelector('.tarjeta-icono')!.cloneNode(true));
      titulo.textContent = tarjeta.querySelector('h3')?.textContent ?? '';
      descripcion.textContent = tarjeta.querySelector('.tarjeta-descripcion')?.textContent ?? '';
      dialogo.classList.remove('cerrando');
      dialogo.showModal();
    };

    // Al cerrar, sale girando; cuando acaba la animación se cierra de verdad.
    const cerrar = () => {
      if (!dialogo.open || dialogo.classList.contains('cerrando')) return;
      const fin = () => {
        dialogo.classList.remove('cerrando');
        dialogo.close();
        origen?.focus();
      };
      if (sinMovimiento.matches) return fin();
      dialogo.classList.add('cerrando');
      panel.addEventListener('animationend', fin, { once: true });
    };

    raiz.querySelectorAll<HTMLElement>('.tarjeta-servicio').forEach((tarjeta) => {
      const nombre = tarjeta.querySelector('h3')?.textContent?.trim() ?? '';
      tarjeta.setAttribute('role', 'button');
      tarjeta.tabIndex = 0;
      tarjeta.setAttribute('aria-haspopup', 'dialog');
      tarjeta.setAttribute('aria-label', `${nombre}: ver descripción`);
      tarjeta.addEventListener('click', () => abrir(tarjeta));
      tarjeta.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          abrir(tarjeta);
        }
      });
    });

    dialogo.querySelector('[data-cerrar]')!.addEventListener('click', cerrar);
    dialogo.addEventListener('cancel', (e) => {
      e.preventDefault(); // Esc: con la animación de salida
      cerrar();
    });
    // Un clic fuera del recuadro (en el fondo oscuro) cae en el propio <dialog>.
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo) cerrar();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-servicios]').forEach((raiz) => {
    const lista = raiz.querySelector<HTMLElement>('[role="tablist"]');
    if (!lista) return;
    const pestanas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneles = pestanas.map((p) => document.getElementById(p.getAttribute('aria-controls') ?? ''));

    const activar = (i: number, { foco = false, animar = true } = {}) => {
      if (pestanas[i].getAttribute('aria-selected') === 'true') return;
      // Las tarjetas solo entran animadas al cambiar de pestaña, no al cargar la página.
      raiz.classList.toggle('servicios-animar', animar);
      pestanas.forEach((p, j) => {
        const activa = j === i;
        p.setAttribute('aria-selected', String(activa));
        p.tabIndex = activa ? 0 : -1;
        if (paneles[j]) paneles[j]!.hidden = !activa;
      });
      lista.dataset.activo = pestanas[i].dataset.grupo;
      if (foco) pestanas[i].focus();
    };

    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => activar(i));
      p.addEventListener('keydown', (e) => {
        const n = pestanas.length;
        const destino = { ArrowRight: i + 1, ArrowLeft: i - 1 + n, Home: 0, End: n - 1 }[e.key];
        if (destino === undefined) return;
        e.preventDefault();
        activar(destino % n, { foco: true });
      });
    });

    // Un enlace a /servicios#infanto-juvenil abre directamente esa pestaña.
    const desdeEnlace = pestanas.findIndex((p) => `#${p.dataset.grupo}` === location.hash);
    if (desdeEnlace > 0) activar(desdeEnlace, { animar: false });
  });
</script>
