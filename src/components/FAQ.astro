---
import { faqs } from '../data/content';
import { Icon } from 'astro-icon/components';
---

<section class="section bg-white">
  <div class="container-prose grid lg:grid-cols-3 gap-10">
    <div class="lg:col-span-1">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2 class="mt-3 text-3xl sm:text-4xl text-brand-900">Respuestas a las dudas más comunes</h2>
      <p class="mt-4 text-brand-700">
        ¿No encuentras tu pregunta? Escríbeme y te respondo personalmente.
      </p>
    </div>

    <div class="lg:col-span-2 space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-cream-100 rounded-2xl px-5 py-4 border border-transparent open:border-brand-200">
          <summary class="flex justify-between items-center gap-4 cursor-pointer list-none font-display font-semibold text-brand-900">
            <span>{faq.pregunta}</span>
            <Icon name="lucide:chevron-down" class="w-5 h-5 text-brand-500 transition-transform group-open:rotate-180 shrink-0" />
          </summary>
          <p class="mt-3 text-sm text-brand-700 leading-relaxed">{faq.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
